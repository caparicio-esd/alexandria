# Copy to .env and fill in. Never commit the result: every secret this
# deployment has is in it.
#
# Generate the three random values with:
#
#   openssl rand -hex 32      session key, database passwords
#   openssl rand -hex 16      Zitadel master key (32 characters, exactly)

# ===== Addresses =============================================================
# Both must resolve to this host over the public internet before the first
# `docker compose up`: Caddy issues certificates from Let's Encrypt, which
# validates by connecting back on port 80.
ALEXANDRIA_DOMAIN=alexandria.example.org
AUTH_DOMAIN=auth.example.org
# Where expiry warnings and ACME problem reports go.
ACME_EMAIL=ops@example.org

# ===== Image =================================================================
# Pin a version rather than tracking :latest — an identity boundary that
# changes underneath a `docker compose pull` is a change to how every login
# behaves. Published by .github/workflows/release.yaml on every tag.
ALEXANDRIA_IMAGE=quay.io/alexandria/alexandria:latest

# ===== The node's database ===================================================
POSTGRES_USER=alexandria
POSTGRES_PASSWORD=
POSTGRES_DB=alexandria

# ===== Sessions ==============================================================
# 32 bytes of hex. It seals every session cookie: change it and everybody is
# logged out, lose it and nobody can be logged in at all.
ALEXANDRIA_AUTH_CONFIG_SESSION_KEY=

# ===== The wallet ============================================================
# The SSI wallet this node links to at startup, deployed by this compose file
# as fafnir-wallet. It holds the node's private key and does the signing.
FAFNIR_IMAGE=rmenendez8/fafnir:v0.2.0
FAFNIR_DB_USER=fafnir
FAFNIR_DB_PASSWORD=
FAFNIR_DB_NAME=fafnir

# Leave these alone to use the wallet above. Set them to point the node at one
# that runs somewhere else instead — the node does not care which, and nothing
# in this file assumes it is the bundled one.
WALLET_PROTOCOL=http
WALLET_HOST=fafnir-wallet
WALLET_PORT=7001

# ===== Identity ==============================================================
ZITADEL_VERSION=v4.17.2
ZITADEL_DB_USER=zitadel
ZITADEL_DB_PASSWORD=
ZITADEL_DB_NAME=zitadel

# Exactly 32 characters. It encrypts every secret Zitadel stores, and there is
# no recovery from losing it: the database becomes unreadable.
ZITADEL_MASTERKEY=

# The first administrator. Zitadel demands a change at the first login, so this
# value stops being the password almost immediately — but it is still written
# here, so treat it as a secret.
ZITADEL_ORG=alexandria
ZITADEL_ADMIN_USER=admin
ZITADEL_ADMIN_PASSWORD=

# The loopback port the management API is published on, for bootstrap.sh. Not
# reachable from outside this host.
ZITADEL_HOST_PORT=1600

# ===== Written by bootstrap.sh ===============================================
# Leave these empty. `bash bootstrap.sh` registers this node as an application
# in Zitadel and appends the credentials it generates — the client id cannot be
# chosen, Zitadel mints it — below this line.
ALEXANDRIA_AUTH_CONFIG_CLIENT_ID=
ALEXANDRIA_AUTH_CONFIG_CLIENT_SECRET=

# ===== Logging ===============================================================
LOG_LEVEL=info
