# Local TLS terminator.
#
# It exists so that development looks like a deployment: the node and Zitadel
# speak plain HTTP behind it, the browser speaks HTTPS, and the session cookie
# can carry the Secure attribute it must carry in production. Without it, every
# cookie setting has to be wrong locally and right in the deployment file, which
# is how a Secure-flag bug reaches production unnoticed.
{
	# The internal issuer, never a public ACME endpoint. The names resolve
	# through nip.io — anything.127.0.0.1.nip.io answers 127.0.0.1 — which is
	# what keeps this working without an entry in /etc/hosts. A .localhost name
	# would need one: curl and browsers resolve those on their own, Go does
	# not.
	local_certs

	# Silence the admin API. Nothing here reconfigures Caddy at runtime.
	admin off

	# The root is the project's own authority, generated by `task tls:ca` into
	# .certs/ and trusted once with `task tls:trust`. Only the root is mounted,
	# read-only: the intermediate is generated here, inside the container's
	# writable volume, so Caddy can renew it without writing to anything the
	# repository tracks.
	pki {
		ca local {
			# Names the intermediate this CA generates, so a certificate
			# inspected in a browser says where it came from.
			name "Alexandria Local Authority"
			root {
				format pem_file
				cert /pki/root.crt
				key /pki/root.key
			}
		}
	}
}

# The node. It runs on the host — `task dev` — so it is reached through the
# address Docker Desktop publishes the host under.
alexandria.127.0.0.1.nip.io {
	reverse_proxy host.docker.internal:1234
}

# The identity provider, which is a container on this network.
auth.127.0.0.1.nip.io {
	reverse_proxy zitadel:8080
}
